# ProfessorOS Frontend Configuration
# Copy this file to .env and adjust values as needed

# Backend API base URL
# Web/local development:
API_BASE_URL=http://localhost:8000/api/v1
# Android emulator uses http://10.0.2.2:8000/api/v1 for a backend on the host.
# Physical devices should use the host LAN IP or deployed HTTPS API URL.
