# ProfessorOS Environment Configuration
# Copy this file to .env and fill in your values
# ⚠️ NEVER commit the actual .env file to version control!

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://professor_os:changeme_in_production@db:5432/professor_os_db
POSTGRES_USER=professor_os
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=professor_os_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────
# MUST be at least 32 characters - generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-chars-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security ──────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Email ─────────────────────────────────────────────
EMAIL_BACKEND=smtp
EMAIL_FROM=noreply@professoros.edu.pk

# Gmail SMTP (app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ── App ───────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
# Comma-separated list of allowed CORS origins (NO wildcards in production)
# Example: ALLOWED_ORIGINS=http://localhost:8080,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:8080
DEBUG=false

