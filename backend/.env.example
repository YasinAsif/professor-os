# ProfessorOS Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://professor_os:changeme_in_production@db:5432/professor_os_db
POSTGRES_USER=professor_os
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=professor_os_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security ──────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Email ─────────────────────────────────────────────
# Options: "resend" | "smtp" | "console"
EMAIL_BACKEND=console
EMAIL_FROM=onboarding@resend.dev

# Resend SDK (primary)
RESEND_API_KEY=

# Gmail SMTP fallback (app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── App ───────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
DEBUG=True

